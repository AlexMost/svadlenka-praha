#: src/templates/baseHTML.mjs
msgid "Ochrana osobních údajů"
msgstr "Privacy policy"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Zásady ochrany osobních údajů"
msgstr "Privacy Policy"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Kdo je správce"
msgstr "Who is the data controller"

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Kontakt: e-mail ${ email }, telefon ${ phone }, nebo osobně v provozovně."
msgstr "Contact: email ${ email }, phone ${ phone }, or in person at the atelier."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Údaje klientů"
msgstr "Client data"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Když u nás zadáte zakázku, zapíšeme do našeho interního systému (CRM) vaše jméno, telefonní číslo a údaje o zakázce: oděv, požadované práce, cenu, zálohu, termín a případné poznámky."
msgstr "When you place an order with us, we record in our internal system (CRM) your name, phone number and the order details: the garment, the work required, the price, the deposit, the deadline and any notes."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Když je zakázka hotová, pošleme vám SMS. SMS odesíláme přes službu BulkGate, které předáváme jen vaše telefonní číslo a text zprávy."
msgstr "When your order is ready, we send you a text message. Text messages are sent through the BulkGate service, which receives only your phone number and the message text."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Vaše údaje neprodáváme a nepoužíváme k reklamě."
msgstr "We do not sell your data or use it for advertising."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Kdo s údaji pracuje"
msgstr "Who handles the data"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Naši zaměstnanci, kteří zakázky přijímají a zpracovávají."
msgstr "Our staff who take in and work on the orders."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "DigitalOcean – server, na kterém běží náš systém."
msgstr "DigitalOcean – the server our system runs on."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "BulkGate – odesílání SMS."
msgstr "BulkGate – sending text messages."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "OpenAI a Telegram – interní asistent, který našim zaměstnancům odpovídá na dotazy k zakázkám. OpenAI údaje nepoužívá k trénování modelů."
msgstr "OpenAI and Telegram – an internal assistant that answers our staff's questions about orders. OpenAI does not use the data to train its models."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Jak dlouho údaje uchováváme"
msgstr "How long we keep the data"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Údaje o zakázce uchováváme 3 roky od jejího vyřízení, kvůli případným reklamacím. Účetní doklady uchováváme po dobu, kterou stanoví zákon. Zálohy systému se mažou po 14 dnech."
msgstr "We keep order data for 3 years after the order is completed, in case of complaints. Accounting records are kept for the period required by law. System backups are deleted after 14 days."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Přihlášení zaměstnanců přes Google"
msgstr "Staff sign-in with Google"

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Naši zaměstnanci se do interního systému ${ crm } přihlašují účtem Google. Od Google přitom dostáváme jen e-mail, jméno a profilovou fotografii, a používáme je jen k přihlášení a k zobrazení, kdo co v systému udělal."
msgstr "Our staff sign in to the internal system ${ crm } with their Google account. From Google we receive only their email, name and profile photo, and use them only for signing in and to show who did what in the system."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Údaje od Google (Google Business Profile)"
msgstr "Google user data (Google Business Profile)"

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Náš interní systém ${ crm } se může připojit k profilu firmy Krejčovství Švadlenka na Google s oprávněním business.manage. Toto oprávnění používáme jen k jednomu účelu: k úpravě otevírací doby našeho vlastního profilu firmy na Google (včetně svátků a mimořádných změn)."
msgstr "Our internal system ${ crm } can connect to the Google Business Profile of Krejčovství Švadlenka with the business.manage permission. We use this permission for one purpose only: to update the opening hours of our own business profile on Google (including holidays and temporary changes)."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Přístupové tokeny od Google ukládáme jen na serveru našeho systému."
msgstr "Google access tokens are stored only on our system's server."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Tokeny ani žádné údaje získané od Google nepředáváme třetím stranám a nepoužíváme je k ničemu jinému, ani k reklamě."
msgstr "We do not share the tokens or any data received from Google with third parties, and do not use them for anything else, including advertising."

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Používání údajů získaných z Google API se řídí zásadami ${ googlePolicy }, včetně požadavků Limited Use."
msgstr "Our use of information received from Google APIs adheres to the ${ googlePolicy }, including the Limited Use requirements."

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Přístup lze kdykoli odvolat v nastavení účtu Google na adrese ${ googlePermissions }, nebo nám napište a připojení zrušíme. Po odvolání přístupu uložené tokeny smažeme."
msgstr "Access can be revoked at any time in your Google Account settings at ${ googlePermissions }, or write to us and we will disconnect it. After access is revoked, we delete the stored tokens."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Tento web"
msgstr "This website"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Vaše práva"
msgstr "Your rights"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Máte právo požádat o přístup ke svým údajům, o jejich opravu nebo výmaz, o omezení zpracování a o přenesení údajů, a máte právo vznést námitku."
msgstr "You have the right to request access to your data, its rectification or erasure, restriction of processing and data portability, and the right to object."

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Stačí nám napsat na ${ email }, zavolat na ${ phone } nebo přijít osobně. Odpovíme do jednoho měsíce."
msgstr "Just email us at ${ email }, call ${ phone } or come in person. We will reply within one month."

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Pokud nejste spokojeni, můžete podat stížnost u Úřadu pro ochranu osobních údajů (${ uoou })."
msgstr "If you are not satisfied, you can lodge a complaint with the Czech Office for Personal Data Protection (Úřad pro ochranu osobních údajů, ${ uoou })."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Zásady ochrany osobních údajů | Krejčovství Švadlenka"
msgstr "Privacy Policy | Krejčovství Švadlenka"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Jak Krejčovství Švadlenka zpracovává osobní údaje klientů a údaje od Google, a jak můžete uplatnit svá práva."
msgstr "How Krejčovství Švadlenka processes clients' personal data and Google user data, and how you can exercise your rights."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "ochrana osobních údajů, GDPR, krejčovství Švadlenka"
msgstr "privacy policy, GDPR, Švadlenka tailor"

#: src/pages/ochrana-osobnich-udaju.mjs
#, javascript-format
msgid "Tyto zásady platí od ${ effectiveDate }"
msgstr "This policy is effective from ${ effectiveDate }"

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Správcem osobních údajů je Larysa Mostovenko, IČO 22654321, se sídlem Dářská 665/20, 198 00 Praha 9. Pod názvem Krejčovství Švadlenka provozuje provozovnu na adrese Jaromírova 726/15, 128 00 Praha 2."
msgstr "The data controller is Larysa Mostovenko, IČO 22654321, registered at Dářská 665/20, 198 00 Praha 9. She runs the atelier Krejčovství Švadlenka at Jaromírova 726/15, 128 00 Praha 2."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Údaje používáme jen k vyřízení zakázky: abychom věděli, co máme udělat, a mohli vás kontaktovat. Právním základem je plnění smlouvy (čl. 6 odst. 1 písm. b) GDPR), u účetních a daňových dokladů plnění našich zákonných povinností (písm. c) a po vyřízení zakázky náš oprávněný zájem na vyřízení případné reklamace nebo sporu (písm. f)."
msgstr "We use the data only to handle your order: to know what to do and to be able to contact you. The legal basis is the performance of a contract (Art. 6(1)(b) GDPR), for accounting and tax records our legal obligations (Art. 6(1)(c)), and after the order is completed our legitimate interest in handling any complaint or dispute (Art. 6(1)(f))."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Jméno a telefonní číslo potřebujeme k přijetí zakázky. Bez nich zakázku nemůžeme přijmout ani vám dát vědět, že je hotová."
msgstr "We need your name and phone number to accept an order. Without them we cannot accept the order or let you know when it is ready."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "OpenAI, DigitalOcean a Telegram mohou údaje zpracovávat i mimo Evropský hospodářský prostor, zejména v USA. U OpenAI a DigitalOcean se předání řídí jejich smluvními podmínkami pro zpracování údajů se standardními smluvními doložkami schválenými Evropskou komisí, případně rozhodnutím Komise o odpovídající ochraně (EU-U.S. Data Privacy Framework). Telegram ukládá zprávy na svých serverech, které mohou být i mimo EU."
msgstr "OpenAI, DigitalOcean and Telegram may process the data outside the European Economic Area, in particular in the USA. For OpenAI and DigitalOcean, the transfer is governed by their data processing terms with the standard contractual clauses approved by the European Commission, or by the Commission's adequacy decision (EU-U.S. Data Privacy Framework). Telegram stores messages on its servers, which may also be outside the EU."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Na tomto webu nemáme formuláře ani uživatelské účty. Přes službu Google Tag Manager používáme Google Analytics, abychom věděli, kolik lidí web navštěvuje a které stránky čtou, a měření konverzí Google Ads, abychom věděli, zda lidé, kteří k nám přišli z reklamy na Googlu, klikli na náš telefon nebo na mapu. Na stránkách je také vložená mapa Google Maps."
msgstr "This website has no forms or user accounts. Through Google Tag Manager we use Google Analytics, to know how many people visit the website and which pages they read, and Google Ads conversion tracking, to know whether people who came to us from an ad on Google clicked our phone number or the map. The pages also embed a Google Maps map."

#: src/pages/ochrana-osobnich-udaju.mjs
msgid "Tyto služby ukládají do vašeho prohlížeče cookies a předávají společnosti Google údaje jako IP adresu, typ zařízení a prohlížeče a navštívené stránky. Poskytovatelem je Google Ireland Limited; údaje mohou být předány i do USA na základě rozhodnutí Evropské komise o odpovídající ochraně (EU-U.S. Data Privacy Framework). Cookies můžete kdykoli smazat nebo zablokovat v nastavení svého prohlížeče."
msgstr "These services store cookies in your browser and send Google data such as your IP address, device and browser type, and the pages you visit. The provider is Google Ireland Limited; the data may also be transferred to the USA under the European Commission's adequacy decision (EU-U.S. Data Privacy Framework). You can delete or block cookies at any time in your browser settings."
